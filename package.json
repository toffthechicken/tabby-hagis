    "@angular/platform-browser": "^15.2.10",
    "@electron/remote": "^2.1.3",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.5",
    "dompurify": "^3.4.17",
    "electron": "^38.8.6",
    "marked": "^12.0.2",
    "rxjs": "^7.8.2",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "ts-loader": "^9.6.2",
    "typescript": "4.9",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4"
  }
