{
  "name": "tabby-hagis",
  "version": "0.1.0",
  "description": "hagis by tabby — workspace plugin for network engineers: customer layouts, main stage + previews, web GUI panes, dock, resume / 네트워크 엔지니어용 통합 워크스페이스",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "ssh",
    "telnet",
    "serial",
    "network",
    "network-engineer",
    "workspace",
    "web-gui",
    "terminal"
  ],
  "homepage": "https://github.com/toffthechicken/tabby-hagis#readme",
  "bugs": {
    "url": "https://github.com/toffthechicken/tabby-hagis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toffthechicken/tabby-hagis.git"
  },
  "license": "MIT",
  "author": "JakeandToff (https://www.instagram.com/toomuchthought.kr/)",
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit -p .",
    "install-plugin": "node scripts/install.js",
    "deploy": "npm run build && npm run install-plugin",
    "package": "npm run build && node scripts/package.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
